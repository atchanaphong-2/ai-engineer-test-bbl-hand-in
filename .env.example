# Copy to .env and fill in your Anthropic API key.
# Direct API key, no cloud account or profile needed. Get a key at
# https://console.anthropic.com/settings/keys.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Retrieval ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
KB_PATH=knowledge_base.txt
KB_INDEX_PATH=kb_index.sqlite3
RETRIEVAL_K=4
# Minimum similarity score a search result needs to be returned at all;
# below this, search() returns an empty list rather than a low-confidence chunk.
SIMILARITY_FLOOR=0.2

# --- Server (run.py only; main.py's CLI doesn't bind a port) ---
HOST=0.0.0.0
PORT=8000

# --- Model ---
# Low and deterministic by default, since answers should track the retrieved
# snippets rather than vary run-to-run.
TEMPERATURE=0.0
